@page
@model Gevitas.Zeiterfassung.Web.Pages.Account.PasswortAendernModel
@{
    ViewData["Title"] = T("Passwort ändern");
}
<section class="karte" style="max-width: 520px">
    @if (Model.Pflicht)
    {
        <div class="hinweis hinweis-warnung">@T("Bitte vergeben Sie vor der weiteren Nutzung ein eigenes Passwort.")</div>
    }
    <form method="post" class="formular">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <label class="feld">
            <span>@T("Aktuelles Passwort")</span>
            <input asp-for="AltesPasswort" type="password" autocomplete="current-password" required />
            <span asp-validation-for="AltesPasswort" class="feld-fehler"></span>
        </label>
        <label class="feld">
            <span>@T("Neues Passwort")</span>
            <input asp-for="NeuesPasswort" type="password" autocomplete="new-password" required />
            <span class="feld-hilfe">@T("Mindestens 8 Zeichen, Groß- und Kleinbuchstaben sowie eine Ziffer.")</span>
            <span asp-validation-for="NeuesPasswort" class="feld-fehler"></span>
        </label>
        <label class="feld">
            <span>@T("Neues Passwort wiederholen")</span>
            <input asp-for="Wiederholung" type="password" autocomplete="new-password" required />
            <span asp-validation-for="Wiederholung" class="feld-fehler"></span>
        </label>
        <div class="knopfleiste">
            <button type="submit" class="knopf">@T("Passwort ändern")</button>
        </div>
    </form>
</section>
