@page
@model Gevitas.Zeiterfassung.Web.Pages.Antraege.AbwesenheitModel
@{
    ViewData["Title"] = T("Abwesenheit eintragen");
    string Iso(DateOnly? d) => d?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
    var tage = T("Tage");
}
<div class="raster raster-2">
    <section class="karte">
        <h2><svg class="icon"><use href="#i-kalender" /></svg>@T("Abwesenheit beantragen")</h2>
        <form method="post" class="formular">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <input type="hidden" name="Zurueck" value="@Model.Zurueck" />

            <div class="formular-raster">
                <label class="feld"><span>@T("Beginn")</span><input type="date" name="Von" value="@Iso(Model.Von)" required /></label>
                <label class="feld"><span>@T("Ende")</span><input type="date" name="Bis" value="@Iso(Model.Bis)" required /></label>
            </div>

            <label class="feld">
                <span>@T("Art der Abwesenheit (Pflichtfeld)")</span>
                <select name="Art" required>
                    <option value="">@T("Art der Abwesenheit wählen …")</option>
                    @foreach (var art in Model.Arten)
                    {
                        <option value="@art.Code" selected="@(Model.Art == art.Code)">@T(art.Name) (@art.Code)</option>
                    }
                </select>
            </label>

            <label class="feld">
                <span>@T("Bemerkung")</span>
                <textarea name="Bemerkung" rows="3">@Model.Bemerkung</textarea>
            </label>

            <div class="knopfleiste">
                <button type="submit" class="knopf">@T("Abwesenheit eintragen")</button>
                <a class="knopf knopf-sekundaer" asp-page="/Zeitwirtschaft/Monatskalender">@T("Abbrechen")</a>
            </div>
            <p class="feld-hilfe">@T("Der Antrag wird an Ihre Führungskraft gesendet, die per Benachrichtigung zur Genehmigung aufgefordert wird.")</p>
        </form>
    </section>

    <section class="karte">
        <h2>@T("Urlaub") @Model.Urlaub.Jahr</h2>
        <ul class="detail-liste">
            <li><span>@T("Jahresanspruch")</span><strong>@Zeitformat.Tage(Model.Urlaub.Anspruch) @tage</strong></li>
            <li><span>@F("Übertrag aus Vorjahr (verfällt nach {0})", Zeitformat.Datum(Model.Urlaub.Verfall))</span><strong>@Zeitformat.Tage(Model.Urlaub.Uebertrag) @tage</strong></li>
            <li><span>@T("Urlaubssaldo (tagesaktuell)")</span><strong>@Zeitformat.Tage(Model.Urlaub.Urlaubssaldo) @tage</strong></li>
            <li><span>@T("Resturlaub (Plan zum 31.12.)")</span><strong>@Zeitformat.Tage(Model.Urlaub.ResturlaubPlan) @tage</strong></li>
        </ul>

        <h3 style="margin-top:1.25rem">@T("Hinweise")</h3>
        <ul class="feld-hilfe">
            <li>@F("„Krank ohne Attest“ ist für maximal {0} zusammenhängende Kalendertage möglich. Längere Arbeitsunfähigkeiten sind per ärztlicher Bescheinigung (eAU) nachzuweisen.", Model.Optionen.KrankOhneAttestMaxTage)</li>
            <li>@T("Bis die Bestätigung der eAU vorliegt, wählen Sie bitte „Krank mit eAU“ – so läuft Ihr Arbeitszeitkonto nicht ins Minus. Die Personalabteilung bucht nach Eingang um.")</li>
            <li>@T("Sonderurlaub für Eheschließung, Niederkunft, goldene Hochzeit und Umzug ist per Urkunde bei der Personalabteilung nachzuweisen.")</li>
            <li>@T("Arbeiten Sie an einem Urlaubs- oder Krankheitstag doch, stornieren Sie bitte die Abwesenheit – sonst wird die Arbeitszeit nicht gutgeschrieben.")</li>
        </ul>
    </section>
</div>
