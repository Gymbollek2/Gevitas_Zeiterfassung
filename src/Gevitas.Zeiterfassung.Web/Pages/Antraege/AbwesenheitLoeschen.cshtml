@page
@model Gevitas.Zeiterfassung.Web.Pages.Antraege.AbwesenheitLoeschenModel
@{
    ViewData["Title"] = T("Abwesenheit löschen");
}
<section class="karte">
    <h2><svg class="icon"><use href="#i-loeschen" /></svg>@T("An- oder Abwesenheit löschen")</h2>
    <p class="feld-hilfe">@T("Noch nicht genehmigte Abwesenheiten werden sofort gelöscht. Für bereits genehmigte Abwesenheiten wird ein Löschantrag an Ihre Führungskraft gestellt – erst nach deren Genehmigung wird die Abwesenheit storniert.")</p>

    @if (Model.Liste.Count == 0)
    {
        <div class="hinweis">@T("Keine (löschbaren) Daten vorhanden.")</div>
    }
    else
    {
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead>
                    <tr><th>@T("Zeitraum")</th><th>@T("Art")</th><th>@T("Status")</th><th>@T("Bemerkung")</th><th class="aktionen"></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Liste)
                    {
                        var name = T(a.Art?.Name ?? a.ArtCode);
                        <tr>
                            <td>@Zeitformat.Datum(a.Von) – @Zeitformat.Datum(a.Bis)</td>
                            <td><span class="legende-punkt" style="background:@a.Art?.Farbe"></span>@name (@a.ArtCode)</td>
                            <td><span class="plakette @(a.Status == AbwesenheitsStatus.Genehmigt ? "plakette-gruen" : "plakette-gelb")">@a.Status.Text()</span></td>
                            <td>@a.Bemerkung</td>
                            <td class="aktionen">
                                <form method="post" data-bestaetigen="@F("{0} vom {1} bis {2} löschen?", name, Zeitformat.Datum(a.Von), Zeitformat.Datum(a.Bis))" data-bestaetigen-titel="@T("Eintrag löschen")">
                                    <input type="hidden" name="abwesenheitId" value="@a.Id" />
                                    <input type="hidden" name="Bemerkung" />
                                    <button type="submit" class="knopf knopf-gefahr knopf-klein">@T("Eintrag löschen")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
