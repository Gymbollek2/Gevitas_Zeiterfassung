@page
@model Gevitas.Zeiterfassung.Web.Pages.Antraege.IndexModel
@{
    ViewData["Title"] = "Anträge";
    var genehmigerSicht = Model.Sicht == AntragsSicht.Genehmiger;
}
<section class="karte">
    <form method="get" class="filterleiste">
        <label class="feld">
            <span>Ab Datum</span>
            <input type="date" name="ab" value="@Model.Ab?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" data-auto-absenden />
        </label>
        @if (Model.DarfGenehmigen)
        {
            <label class="feld">
                <span>Rolle</span>
                <select name="sicht" data-auto-absenden>
                    <option value="Antragsteller" selected="@(!genehmigerSicht)">Antragsteller</option>
                    <option value="Genehmiger" selected="@genehmigerSicht">Genehmiger</option>
                </select>
            </label>
        }
        <label class="feld">
            <span>Status</span>
            <select name="filter" data-auto-absenden>
                <option value="Offen" selected="@(Model.Filter == AntragsFilter.Offen)">Offen</option>
                <option value="Alle" selected="@(Model.Filter == AntragsFilter.Alle)">Alle</option>
                <option value="Erledigt" selected="@(Model.Filter == AntragsFilter.Erledigt)">Erledigt</option>
            </select>
        </label>
        <noscript><button type="submit" class="knopf">Filtern</button></noscript>
        <a class="knopf" asp-page="/Antraege/Abwesenheit"><svg class="icon"><use href="#i-plus" /></svg>Abwesenheit beantragen</a>
    </form>

    @if (Model.Liste.Count == 0)
    {
        <div class="hinweis">Keine Anträge für den gewählten Zeitraum, die Rolle oder den Status vorhanden.</div>
    }
    else
    {
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead>
                    <tr>
                        <th>Antrag</th>
                        <th>Erstellt am</th>
                        @if (genehmigerSicht)
                        {
                            <th>Mitarbeiter/in</th>
                        }
                        <th>Details</th>
                        <th>Bemerkung (Antrag)</th>
                        <th>Status</th>
                        <th>Genehmiger / Entscheidung</th>
                        <th class="aktionen">Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Liste)
                    {
                        var statusKlasse = a.Status switch
                        {
                            AntragsStatus.Genehmigt => "plakette-gruen",
                            AntragsStatus.Abgelehnt => "plakette-rot",
                            AntragsStatus.Zurueckgezogen => "plakette-grau",
                            _ => "plakette-gelb"
                        };
                        <tr>
                            <td><strong>@a.Art.Text()</strong>@(a.Stufen > 1 ? $" (Stufe {a.Stufe}/{a.Stufen})" : "")</td>
                            <td>@Zeitformat.Zeitpunkt(a.ErstelltAm)</td>
                            @if (genehmigerSicht)
                            {
                                <td>@a.Antragsteller?.AnzeigeName</td>
                            }
                            <td>@AntragsService.Beschreibung(a)</td>
                            <td>@a.Bemerkung</td>
                            <td><span class="plakette @statusKlasse">@a.Status.Text()</span></td>
                            <td>
                                @if (a.Status == AntragsStatus.Offen)
                                {
                                    <span>@(a.Genehmiger?.AnzeigeName ?? "Personalabteilung")</span>
                                }
                                else
                                {
                                    <span>@(a.EntschiedenVon?.AnzeigeName ?? "–")</span>
                                    @if (!string.IsNullOrEmpty(a.Entscheidungsbemerkung))
                                    {
                                        <br /><em>@a.Entscheidungsbemerkung</em>
                                    }
                                }
                            </td>
                            <td class="aktionen">
                                @if (Model.DarfEntscheiden(a))
                                {
                                    <form method="post" class="knopfleiste" style="justify-content:flex-end">
                                        <input type="hidden" name="antragId" value="@a.Id" />
                                        <input type="hidden" name="filter" value="@Model.Filter" />
                                        <input type="text" name="bemerkung" class="eingabe" placeholder="Bemerkung (bei Ablehnung Pflicht)" style="max-width:220px" />
                                        <button type="submit" class="knopf knopf-erfolg knopf-klein" asp-page-handler="Genehmigen" title="Genehmigen">✓ Genehmigen</button>
                                        <button type="submit" class="knopf knopf-gefahr knopf-klein" asp-page-handler="Ablehnen" title="Ablehnen">✕ Ablehnen</button>
                                    </form>
                                }
                                else if (a.Status == AntragsStatus.Offen && a.AntragstellerId == User.MitarbeiterId())
                                {
                                    <form method="post" asp-page-handler="Zurueckziehen" data-bestaetigen="Diesen offenen Antrag löschen? Er wird Ihrer Führungskraft dann nicht mehr angezeigt." data-bestaetigen-titel="Antrag löschen">
                                        <input type="hidden" name="antragId" value="@a.Id" />
                                        <input type="hidden" name="sicht" value="@Model.Sicht" />
                                        <input type="hidden" name="filter" value="@Model.Filter" />
                                        <button type="submit" class="knopf knopf-sekundaer knopf-klein"><svg class="icon"><use href="#i-loeschen" /></svg>Löschen</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (genehmigerSicht)
        {
            <p class="feld-hilfe">Anträge werden einzeln genehmigt oder abgelehnt. Bei einer Ablehnung ist eine Begründung erforderlich.</p>
        }
    }
</section>
