@page
@model Gevitas.Zeiterfassung.Web.Pages.Berichte.BerichtModel
@{
    var d = Model.Definition;
    ViewData["Title"] = $"{T("Bericht")} {d.Nummer} – {T(d.Bezeichnung)}";
    string Iso(DateOnly? x) => x?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}
<section class="karte nicht-drucken">
    <form method="get" class="filterleiste">
        <input type="hidden" name="nr" value="@d.Nummer" />
        @if (Model.PersonWaehlbar)
        {
            <label class="feld">
                <span>@T("Person")</span>
                <select name="ma">
                    @foreach (var p in Model.Auswahl)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.Ma)">@p.AnzeigeName (@p.Personalnummer)</option>
                    }
                </select>
            </label>
        }
        @if (d.MitZeitraum)
        {
            <label class="feld"><span>@T("Von")</span><input type="date" name="von" value="@Iso(Model.Von)" /></label>
            <label class="feld"><span>@T("Bis")</span><input type="date" name="bis" value="@Iso(Model.Bis)" /></label>
        }
        else if (d.Nummer != 539)
        {
            <label class="feld"><span>@T("Jahr")</span><input type="number" name="jahr" value="@Model.Jahr" min="2000" max="2100" /></label>
        }
        <div class="knopfleiste">
            <button type="submit" class="knopf">@T("Bericht starten")</button>
            <button type="submit" class="knopf knopf-sekundaer" name="format" value="csv">@T("CSV exportieren")</button>
            <button type="button" class="knopf knopf-sekundaer" data-drucken>@T("Drucken / PDF")</button>
            <a class="knopf knopf-sekundaer" asp-page="/Berichte/Index">@T("Alle Berichte")</a>
        </div>
    </form>
</section>

@if (Model.Daten is { } daten)
{
    <section class="karte">
        <div class="karte-kopf">
            <div>
                <h2>@d.Nummer – @T(d.Bezeichnung)</h2>
                <span class="feld-hilfe">@daten.Untertitel</span>
            </div>
        </div>

        @if (daten.Zeilen.Count == 0)
        {
            <div class="hinweis hinweis-erfolg">@T("Keine Einträge im gewählten Zeitraum.")</div>
        }
        else
        {
            <div class="tabellen-rahmen">
                <table class="tabelle">
                    <thead>
                        <tr>
                            @foreach (var s in daten.Spalten)
                            {
                                <th>@s</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var z in daten.Zeilen)
                        {
                            <tr>
                                @for (var i = 0; i < z.Zellen.Count; i++)
                                {
                                    if (i == 0 && z.Ampel is not null)
                                    {
                                        <td><span class="ampel ampel-@z.Ampel" aria-hidden="true"></span> @(z.Zellen[i])</td>
                                    }
                                    else
                                    {
                                        <td>@(z.Zellen[i])</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @foreach (var h in daten.Hinweise)
        {
            <p class="feld-hilfe">@h</p>
        }
    </section>
}
