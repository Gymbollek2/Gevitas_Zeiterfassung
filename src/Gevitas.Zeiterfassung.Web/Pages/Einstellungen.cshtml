@page
@model EinstellungenModel
@{
    ViewData["Title"] = "Einstellungen";
}
<section class="karte" style="max-width:720px">
    <h2><svg class="icon"><use href="#i-einstellungen" /></svg>Dashboard anpassen</h2>
    <p class="feld-hilfe">Wählen Sie aus, welche Inhalte auf Ihrem Dashboard angezeigt werden. Die Funktion „Krank untertägig“ steht im Dashboard nur zur Verfügung, wenn Sie sie hier hinzufügen – ansonsten tragen Sie sie über die Zeitkorrekturen oder das Terminal ein.</p>
    <form method="post" class="formular">
        @foreach (var (schluessel, bezeichnung, beschreibung) in DashboardKacheln.Alle)
        {
            <label class="checkbox" style="align-items:flex-start">
                <input type="checkbox" name="kacheln" value="@schluessel" checked="@Model.Aktiv.Contains(schluessel)" style="margin-top:.3rem" />
                <span><strong>@bezeichnung</strong><br /><span class="feld-hilfe">@beschreibung</span></span>
            </label>
        }
        <div class="knopfleiste">
            <button type="submit" class="knopf">Speichern</button>
            <button type="submit" class="knopf knopf-sekundaer" asp-page-handler="Standard">Standard wiederherstellen</button>
        </div>
    </form>
</section>
