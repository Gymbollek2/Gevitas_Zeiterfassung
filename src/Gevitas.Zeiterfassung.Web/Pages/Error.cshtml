@page
@model ErrorModel
@{
    ViewData["Title"] = T("Fehler");
}
<section class="karte">
    <h2>@T("Es ist ein Fehler aufgetreten")</h2>
    <p>@T("Die Anfrage konnte nicht verarbeitet werden. Bitte versuchen Sie es erneut.")</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="feld-hilfe">@T("Anfrage-ID"): <code>@Model.RequestId</code></p>
    }
    <a class="knopf" asp-page="/Index">@T("Zum Dashboard")</a>
</section>
