@page
@model IndexModel
@{
    ViewData["Title"] = T("Dashboard");
    var s = Model.Stand;
    var u = Model.Urlaub;
    var std = T("Std.");
    var tage = T("Tage");
}

@if (Model.OffeneGenehmigungen > 0)
{
    <div class="hinweis hinweis-warnung">
        @F("Es sind offene Anträge vorhanden ({0}).", Model.OffeneGenehmigungen)
        <a class="knopf knopf-klein" href="@AntragsService.LinkGenehmiger" style="margin-left:.5rem">@T("Anträge")</a>
    </div>
}

@{
    var mitTerminal = Model.Zeigt(DashboardKacheln.Terminal) || Model.Zeigt(DashboardKacheln.KrankUntertaegig) || Model.Zeigt(DashboardKacheln.Wegezeit);
}
<div class="raster @(mitTerminal && Model.Zeigt(DashboardKacheln.Konten) ? "raster-2" : "")">
    @if (mitTerminal)
    {
        <section class="karte">
            <div class="karte-kopf">
                <h2><svg class="icon"><use href="#i-terminal" /></svg>@T("Terminal")</h2>
                <partial name="_TerminalStatus" model="s" />
            </div>
            <div class="terminal">
                @if (Model.Zeigt(DashboardKacheln.Terminal))
                {
                    <form method="post" asp-page="/Terminal" class="terminal-form">
                        <input type="hidden" name="aktion" value="@TerminalAktion.KommenOderGehen" />
                        <input type="hidden" name="zurueck" value="dashboard" />
                        <button type="submit" class="terminal-knopf primaer"><svg class="icon"><use href="#i-terminal" /></svg>@T("Kommen oder Gehen")</button>
                    </form>
                }
                @if (Model.Zeigt(DashboardKacheln.KrankUntertaegig))
                {
                    <form method="post" asp-page="/Terminal" class="terminal-form">
                        <input type="hidden" name="aktion" value="@TerminalAktion.KrankUntertaegig" />
                        <input type="hidden" name="zurueck" value="dashboard" />
                        <button type="submit" class="terminal-knopf"><svg class="icon"><use href="#i-warnung" /></svg>@T("Krank untertägig")</button>
                    </form>
                }
                @if (Model.Zeigt(DashboardKacheln.Wegezeit))
                {
                    <form method="post" asp-page="/Terminal" class="terminal-form">
                        <input type="hidden" name="aktion" value="@TerminalAktion.WegezeitKommenOderGehen" />
                        <input type="hidden" name="zurueck" value="dashboard" />
                        <button type="submit" class="terminal-knopf"><svg class="icon"><use href="#i-kalender" /></svg>@T("Wegezeit (Kommen oder Gehen)")</button>
                    </form>
                }
            </div>
        </section>
    }

    @if (Model.Zeigt(DashboardKacheln.Konten))
    {
        <section class="karte">
            <div class="karte-kopf">
                <h2><svg class="icon"><use href="#i-info" /></svg>@T("Information")</h2>
                <div class="knopfleiste">
                    <a class="knopf knopf-sekundaer knopf-klein" href="/">@T("Aktualisieren")</a>
                    <a class="knopf knopf-sekundaer knopf-klein knopf-icon" asp-page="/Einstellungen" title="@T("Dashboard anpassen")" aria-label="@T("Dashboard anpassen")"><svg class="icon"><use href="#i-einstellungen" /></svg></a>
                </div>
            </div>
            <div class="kennzahlen">
                <div class="kennzahl @(s.Saldo < 0 ? "negativ" : "")"><span class="kennzahl-label">@T("Saldo")</span><span class="kennzahl-wert">@Zeitformat.Dauer(s.Saldo) <span class="kennzahl-einheit">@std</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Arbeitszeit")</span><span class="kennzahl-wert">@Zeitformat.Dauer(s.HeuteArbeitszeit) <span class="kennzahl-einheit">@std</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Sollstunden")</span><span class="kennzahl-wert">@Zeitformat.Dauer(s.HeuteSoll) <span class="kennzahl-einheit">@std</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Wegezeit (Kontostand)")</span><span class="kennzahl-wert">@Zeitformat.Dauer(s.Wegezeit) <span class="kennzahl-einheit">@std</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Sonderarbeitszeit")</span><span class="kennzahl-wert">@Zeitformat.Dauer(s.Sonderarbeitszeit) <span class="kennzahl-einheit">@std</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Urlaubssaldo")</span><span class="kennzahl-wert">@Zeitformat.Tage(u.Urlaubssaldo) <span class="kennzahl-einheit">@tage</span></span></div>
                <div class="kennzahl"><span class="kennzahl-label">@T("Resturlaub (Plan zum 31.12.)")</span><span class="kennzahl-wert">@Zeitformat.Tage(u.ResturlaubPlan) <span class="kennzahl-einheit">@tage</span></span></div>
            </div>
            <p class="feld-hilfe">
                @T("Saldo minutenaktuell (Stand Vortag + heutige Arbeitszeit − heutiges Soll). Das Urlaubssaldo ist tagesaktuell – bereits genommener Urlaub ist abgezogen.")
                @if (u.Uebertrag > 0)
                {
                    <span>@F("Resturlaub aus dem Vorjahr ({0} Tage) verfällt nach dem {1}, wenn er nicht angetreten wird.", Zeitformat.Tage(u.Uebertrag), Zeitformat.Datum(u.Verfall))</span>
                }
            </p>
        </section>
    }
</div>

@if (!mitTerminal && !Model.Zeigt(DashboardKacheln.Konten))
{
    <div class="hinweis">@T("Ihr Dashboard ist leer.") <a asp-page="/Einstellungen">@T("Inhalte hinzufügen")</a></div>
}

@if (Model.Zeigt(DashboardKacheln.Benachrichtigungen) && Model.Benachrichtigungen.Count > 0)
{
    ViewData["Zurueck"] = "/";
    <section class="karte">
        <div class="karte-kopf">
            <h2><svg class="icon"><use href="#i-glocke" /></svg>@T("Ungelesene Benachrichtigungen")</h2>
            <form method="post" asp-page="/Benachrichtigungen" asp-page-handler="AlleGelesen">
                <input type="hidden" name="zurueck" value="/" />
                <button type="submit" class="knopf knopf-sekundaer knopf-klein">@T("Alle als gelesen markieren")</button>
            </form>
        </div>
        <div class="benachrichtigungs-liste">
            @foreach (var b in Model.Benachrichtigungen)
            {
                <partial name="_BenachrichtigungEintrag" model="b" />
            }
        </div>
    </section>
}
