@page
@using Microsoft.Extensions.Options
@inject IOptions<ZeiterfassungOptions> Einstellungen
@{
    ViewData["Title"] = "Information";
    var o = Einstellungen.Value;
}
<div class="raster raster-2">
    <section class="karte">
        <h2>Darstellung der Zeiten</h2>
        <p>Alle Zeiten werden in <strong>Stunden:Minuten</strong> angezeigt. Die Zahl hinter dem Doppelpunkt ist keine Dezimalzahl, sondern die Anzahl der Minuten.</p>
        <ul>
            <li><code>10:50</code> = 10 Stunden und 50 Minuten</li>
            <li><code>10:30</code> = 10 Stunden und 30 Minuten</li>
        </ul>
    </section>

    <section class="karte">
        <h2>Regeln der Zeiterfassung</h2>
        <ul>
            <li>Rahmenarbeitszeit: @o.Rahmenarbeitszeit.Beginn – @o.Rahmenarbeitszeit.Ende Uhr</li>
            <li>Kappung der täglichen Arbeitszeit nach @Zeitformat.Dauer(o.MaxArbeitszeitMinuten) Stunden (Freigabe per Antrag möglich)</li>
            <li>Pausen: nach @Zeitformat.Dauer(o.Pausen.Schwelle1Minuten) Std. mindestens @o.Pausen.Pause1Minuten Min., nach @Zeitformat.Dauer(o.Pausen.Schwelle2Minuten) Std. mindestens @o.Pausen.Pause2Minuten Min. Eine Unterbrechung zählt ab @o.Pausen.MinPauseMinuten Min. als Pause.</li>
            <li>Zeiten können maximal @o.MaxRueckwirkendeTage Tage rückwirkend erfasst werden; Buchungen in der Zukunft sind nicht möglich.</li>
            <li>„Krank ohne Attest“ ist für höchstens @o.KrankOhneAttestMaxTage zusammenhängende Kalendertage möglich.</li>
        </ul>
    </section>

    <section class="karte">
        <h2>Buchungscodes im Verlauf</h2>
        <ul>
            <li><strong>P10</strong> – Kommen</li>
            <li><strong>P11</strong> – Wechselbuchung</li>
            <li><strong>P20</strong> – Gehen</li>
        </ul>
    </section>

    <section class="karte">
        <h2>Ansprechpartner &amp; Support</h2>
        <p>Die Personalabteilung steht bei Fragen, Anregungen oder benötigter Hilfe unter
            <a href="mailto:@o.Support.PersonalabteilungEmail">@o.Support.PersonalabteilungEmail</a> zur Verfügung.</p>
        <p>@o.Support.ItSupportHinweis</p>
    </section>
</div>
