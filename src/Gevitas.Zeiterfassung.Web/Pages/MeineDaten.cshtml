@page
@model MeineDatenModel
@{
    ViewData["Title"] = T("Meine Daten");
    var m = Model.Ich;
}
<div class="raster raster-2">
    <section class="karte">
        <h2>@T("Persönliche Daten")</h2>
        <ul class="detail-liste">
            <li><span>@T("Name")</span><strong>@m.VollerName</strong></li>
            <li><span>@T("Personalnummer")</span><strong>@m.Personalnummer</strong></li>
            <li><span>@T("Benutzername")</span><strong>@m.Benutzername</strong></li>
            <li><span>@T("E-Mail")</span><strong>@m.Email</strong></li>
            <li><span>@T("Abteilung")</span><strong>@(m.Abteilung ?? "–")</strong></li>
            <li><span>@T("Rolle")</span><strong>@m.Rolle.Text()</strong></li>
            <li><span>@T("Eintrittsdatum")</span><strong>@Zeitformat.Datum(m.Eintrittsdatum)</strong></li>
        </ul>
    </section>

    <section class="karte">
        <h2>@T("Arbeitszeitmodell")</h2>
        <ul class="detail-liste">
            <li><span>@T("Sollarbeitszeit pro Tag")</span><strong>@Zeitformat.Dauer(m.SollMinutenProTag) @T("Std.")</strong></li>
            <li><span>@T("Jahresurlaub")</span><strong>@m.Jahresurlaub @T("Tage")</strong></li>
            <li><span>@T("Disziplinarische Führungskraft")</span><strong>@(m.Vorgesetzter?.VollerName ?? "–")</strong></li>
            <li><span>@T("Abweichender Genehmiger")</span><strong>@(m.AbweichenderGenehmiger?.VollerName ?? "–")</strong></li>
            <li><span>@T("Letzte Anmeldung")</span><strong>@(m.LetzteAnmeldung is null ? "–" : Zeitformat.Zeitpunkt(m.LetzteAnmeldung.Value))</strong></li>
        </ul>
        <p class="feld-hilfe">@T("Als Genehmiger ist automatisch Ihre disziplinarische Führungskraft hinterlegt. Änderungen nimmt die Personalabteilung vor.")</p>
        <a class="knopf knopf-sekundaer" asp-page="/Account/PasswortAendern">@T("Passwort ändern")</a>
    </section>
</div>
