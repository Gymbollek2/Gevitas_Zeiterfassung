@page
@model MeineDatenModel
@{
    ViewData["Title"] = "Meine Daten";
    var m = Model.Ich;
}
<div class="raster raster-2">
    <section class="karte">
        <h2>Persönliche Daten</h2>
        <ul class="detail-liste">
            <li><span>Name</span><strong>@m.VollerName</strong></li>
            <li><span>Personalnummer</span><strong>@m.Personalnummer</strong></li>
            <li><span>Benutzername</span><strong>@m.Benutzername</strong></li>
            <li><span>E-Mail</span><strong>@m.Email</strong></li>
            <li><span>Abteilung</span><strong>@(m.Abteilung ?? "–")</strong></li>
            <li><span>Rolle</span><strong>@m.Rolle.Text()</strong></li>
            <li><span>Eintrittsdatum</span><strong>@Zeitformat.Datum(m.Eintrittsdatum)</strong></li>
        </ul>
    </section>

    <section class="karte">
        <h2>Arbeitszeitmodell</h2>
        <ul class="detail-liste">
            <li><span>Sollarbeitszeit pro Tag</span><strong>@Zeitformat.Dauer(m.SollMinutenProTag) Std.</strong></li>
            <li><span>Jahresurlaub</span><strong>@m.Jahresurlaub Tage</strong></li>
            <li><span>Disziplinarische Führungskraft</span><strong>@(m.Vorgesetzter?.VollerName ?? "–")</strong></li>
            <li><span>Abweichender Genehmiger</span><strong>@(m.AbweichenderGenehmiger?.VollerName ?? "–")</strong></li>
            <li><span>Letzte Anmeldung</span><strong>@(m.LetzteAnmeldung is null ? "–" : Zeitformat.Zeitpunkt(m.LetzteAnmeldung.Value))</strong></li>
        </ul>
        <p class="feld-hilfe">Als Genehmiger ist automatisch Ihre disziplinarische Führungskraft hinterlegt. Änderungen nimmt die Personalabteilung vor.</p>
        <a class="knopf knopf-sekundaer" asp-page="/Account/PasswortAendern">Passwort ändern</a>
    </section>
</div>
