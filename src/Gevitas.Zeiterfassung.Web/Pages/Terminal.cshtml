@page
@model TerminalModel
@{
    ViewData["Title"] = T("Terminal");
    var std = T("Std.");
}
<section class="karte">
    <div class="karte-kopf">
        <h2><svg class="icon"><use href="#i-terminal" /></svg>@T("Terminal") <span data-live-uhr data-sprache="@Texte.Sprache" class="plakette"></span></h2>
        <partial name="_TerminalStatus" model="Model.Stand" />
    </div>
    <p class="feld-hilfe">@T("Gebucht wird immer die aktuelle Uhrzeit. „Ändern“ schließt die laufende Buchung ab und beginnt sofort eine neue (Wechselbuchung).")</p>

    <div class="terminal">
        @foreach (var (aktion, text, icon, primaer) in new[]
        {
            (TerminalAktion.KommenOderGehen, "Kommen oder Gehen", "i-terminal", true),
            (TerminalAktion.Kommen, "Kommen", "i-plus", false),
            (TerminalAktion.Gehen, "Gehen", "i-abmelden", false),
            (TerminalAktion.Aendern, "Ändern", "i-verlauf", false),
            (TerminalAktion.KrankUntertaegig, "Krank untertägig (Gehen)", "i-warnung", false),
            (TerminalAktion.WegezeitKommenOderGehen, "Wegezeit (Kommen oder Gehen)", "i-kalender", false),
            (TerminalAktion.WegezeitKommen, "Wegezeit (Kommen)", "i-plus", false),
            (TerminalAktion.WegezeitGehen, "Wegezeit (Gehen)", "i-abmelden", false)
        })
        {
            <form method="post" class="terminal-form">
                <input type="hidden" name="aktion" value="@aktion" />
                <button type="submit" class="terminal-knopf @(primaer ? "primaer" : "")">
                    <svg class="icon"><use href="#@icon" /></svg>
                    @T(text)
                </button>
            </form>
        }
    </div>
</section>

<section class="karte">
    <h2>@T("Heute")</h2>
    <div class="kennzahlen">
        <div class="kennzahl"><span class="kennzahl-label">@T("Arbeitszeit")</span><span class="kennzahl-wert">@Zeitformat.Dauer(Model.Stand.HeuteArbeitszeit) <span class="kennzahl-einheit">@std</span></span></div>
        <div class="kennzahl"><span class="kennzahl-label">@T("Sollstunden")</span><span class="kennzahl-wert">@Zeitformat.Dauer(Model.Stand.HeuteSoll) <span class="kennzahl-einheit">@std</span></span></div>
        <div class="kennzahl @(Model.Stand.Saldo < 0 ? "negativ" : "")"><span class="kennzahl-label">@T("Saldo")</span><span class="kennzahl-wert">@Zeitformat.Dauer(Model.Stand.Saldo) <span class="kennzahl-einheit">@std</span></span></div>
    </div>
</section>
