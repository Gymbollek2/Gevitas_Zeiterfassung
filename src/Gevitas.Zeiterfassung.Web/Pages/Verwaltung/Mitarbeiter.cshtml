@page
@model Gevitas.Zeiterfassung.Web.Pages.Verwaltung.MitarbeiterModel
@{
    ViewData["Title"] = T("Mitarbeiterverwaltung");
}
<section class="karte">
    <div class="karte-kopf">
        <h2><svg class="icon"><use href="#i-team" /></svg>@T("Mitarbeitende")</h2>
        <a class="knopf" asp-page="/Verwaltung/MitarbeiterBearbeiten"><svg class="icon"><use href="#i-plus" /></svg>@T("Neu anlegen")</a>
    </div>
    <div class="tabellen-rahmen">
        <table class="tabelle">
            <thead>
                <tr>
                    <th>@T("Pers.-Nr.")</th>
                    <th>@T("Name")</th>
                    <th>@T("Benutzer")</th>
                    <th>@T("Rolle")</th>
                    <th>@T("Führungskraft")</th>
                    <th class="zahl">@T("Soll/Tag")</th>
                    <th class="zahl">@T("Urlaub")</th>
                    <th>@T("Status")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model.Liste)
                {
                    <tr>
                        <td>@m.Personalnummer</td>
                        <td>@m.AnzeigeName</td>
                        <td>@m.Benutzername</td>
                        <td>@m.Rolle.Text()</td>
                        <td>@(m.Vorgesetzter?.AnzeigeName ?? "–")</td>
                        <td class="zahl">@Zeitformat.Dauer(m.SollMinutenProTag)</td>
                        <td class="zahl">@m.Jahresurlaub</td>
                        <td>
                            @if (m.Aktiv)
                            {
                                <span class="plakette plakette-gruen">@T("Aktiv")</span>
                            }
                            else
                            {
                                <span class="plakette plakette-grau">@T("Inaktiv")</span>
                            }
                        </td>
                        <td class="aktionen">
                            @if (m.Rolle != Rolle.Administrator || User.Rolle() == Rolle.Administrator)
                            {
                                <a class="knopf knopf-sekundaer knopf-klein" asp-page="/Verwaltung/MitarbeiterBearbeiten" asp-route-id="@m.Id">@T("Bearbeiten")</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
