@page "{id:int?}"
@model Gevitas.Zeiterfassung.Web.Pages.Verwaltung.MitarbeiterBearbeitenModel
@{
    ViewData["Title"] = Model.IstNeu ? T("Mitarbeiter anlegen") : T("Mitarbeiter bearbeiten");
}
<section class="karte">
    <form method="post" class="formular">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <input type="hidden" asp-for="Eingabe.Id" />

        <h2>@T("Stammdaten")</h2>
        <div class="formular-raster">
            <label class="feld"><span>@T("Personalnummer")</span><input asp-for="Eingabe.Personalnummer" required /></label>
            <label class="feld"><span>@T("Benutzername")</span><input asp-for="Eingabe.Benutzername" required autocomplete="off" /></label>
            <label class="feld"><span>@T("Vorname")</span><input asp-for="Eingabe.Vorname" required /></label>
            <label class="feld"><span>@T("Nachname")</span><input asp-for="Eingabe.Nachname" required /></label>
            <label class="feld"><span>@T("E-Mail")</span><input asp-for="Eingabe.Email" type="email" /></label>
            <label class="feld"><span>@T("Abteilung")</span><input asp-for="Eingabe.Abteilung" /></label>
            <label class="feld">
                <span>@T("Rolle")</span>
                <select asp-for="Eingabe.Rolle">
                    @foreach (var rolle in Enum.GetValues<Rolle>())
                    {
                        <option value="@rolle" selected="@(Model.Eingabe.Rolle == rolle)">@rolle.Text()</option>
                    }
                </select>
            </label>
            <label class="feld"><span>@T("Eintrittsdatum")</span><input asp-for="Eingabe.Eintrittsdatum" type="date" /></label>
        </div>

        <h2>@T("Arbeitszeit & Genehmigung")</h2>
        <div class="formular-raster">
            <label class="feld">
                <span>@T("Sollarbeitszeit pro Tag (Std:Min)")</span>
                <input asp-for="Eingabe.SollProTag" placeholder="8:00" />
            </label>
            <label class="feld"><span>@T("Jahresurlaub (Tage)")</span><input asp-for="Eingabe.Jahresurlaub" type="number" min="0" max="60" /></label>
            <label class="feld">
                <span>@T("Disziplinarische Führungskraft")</span>
                <select asp-for="Eingabe.VorgesetzterId">
                    <option value="">@T("– keine –")</option>
                    @foreach (var m in Model.Auswahl)
                    {
                        <option value="@m.Id" selected="@(Model.Eingabe.VorgesetzterId == m.Id)">@m.AnzeigeName</option>
                    }
                </select>
            </label>
            <label class="feld">
                <span>@T("Abweichender Genehmiger (Vertretung)")</span>
                <select asp-for="Eingabe.AbweichenderGenehmigerId">
                    <option value="">@T("– keiner –")</option>
                    @foreach (var m in Model.Auswahl)
                    {
                        <option value="@m.Id" selected="@(Model.Eingabe.AbweichenderGenehmigerId == m.Id)">@m.AnzeigeName</option>
                    }
                </select>
                <span class="feld-hilfe">@T("Wird statt der Führungskraft als Genehmiger verwendet.")</span>
            </label>
        </div>

        <h2>@T("Zugang")</h2>
        <div class="formular-raster">
            <label class="feld">
                <span>@(Model.IstNeu ? T("Startpasswort") : T("Passwort zurücksetzen (optional)"))</span>
                <input asp-for="Eingabe.NeuesPasswort" type="password" autocomplete="new-password" />
                <span class="feld-hilfe">@T("Muss bei der nächsten Anmeldung geändert werden.")</span>
            </label>
            <label class="checkbox"><input asp-for="Eingabe.Aktiv" type="checkbox" /> @T("Zugang aktiv")</label>
        </div>

        <div class="knopfleiste">
            <button type="submit" class="knopf">@T("Speichern")</button>
            <a class="knopf knopf-sekundaer" asp-page="/Verwaltung/Mitarbeiter">@T("Abbrechen")</a>
        </div>
    </form>
</section>
