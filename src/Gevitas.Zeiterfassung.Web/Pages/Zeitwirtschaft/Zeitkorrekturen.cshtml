@page
@model Gevitas.Zeiterfassung.Web.Pages.Zeitwirtschaft.ZeitkorrekturenModel
@{
    ViewData["Title"] = T("Zeitkorrekturen");
    var seite = "/Zeitwirtschaft/Zeitkorrekturen";
    var vormonat = Model.MonatsBeginn.AddMonths(-1);
    var folgemonat = Model.MonatsBeginn.AddMonths(1);
    var auswahl = Model.Auswahl;
    var arten = new[] { BuchungsArt.Arbeit, BuchungsArt.Wegezeit, BuchungsArt.KrankUntertaegig };
}

<div class="filterleiste">
    <div class="monatsnavigation">
        <a class="knopf knopf-sekundaer knopf-icon" href="@Url.Page(seite, Model.RouteFuer(vormonat))" aria-label="@T("Vormonat")">‹</a>
        <strong>@Zeitformat.Monatsname(Model.MonatsBeginn.Month) @Model.MonatsBeginn.Year</strong>
        <a class="knopf knopf-sekundaer knopf-icon" href="@Url.Page(seite, Model.RouteFuer(folgemonat))" aria-label="@T("Folgemonat")">›</a>
    </div>
    @if (Model.Personen.Count > 0)
    {
        <form method="get" class="knopfleiste">
            <input type="hidden" name="monat" value="@Model.MonatText" />
            <label class="feld">
                <span>@T("Mitarbeiter/in")</span>
                <select name="ma" data-auto-absenden>
                    @foreach (var p in Model.Personen)
                    {
                        <option value="@p.Id" selected="@(p.Id == Model.Person.Id)">@p.AnzeigeName (@p.Personalnummer)</option>
                    }
                </select>
            </label>
            <noscript><button class="knopf knopf-klein" type="submit">@T("Anzeigen")</button></noscript>
        </form>
    }
    <span class="plakette">@Model.Person.AnzeigeName</span>
</div>

<div class="korrektur-layout">
    <section class="karte">
        <div class="tabellen-rahmen">
            <table class="tabelle">
                <thead>
                    <tr>
                        <th>@T("Datum")</th>
                        <th>@T("Beginn")</th>
                        <th>@T("Ende")</th>
                        <th>@T("Eigenschaft")</th>
                        <th>@T("Hinweise")</th>
                        <th class="zahl">@T("Soll")</th>
                        <th class="zahl">@T("Ist")</th>
                        <th class="zahl">@T("Saldo")</th>
                        <th class="aktionen">@T("Aktionen")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in Model.Tage)
                    {
                        var bearbeitbar = Model.IstBearbeitbar(tag.Datum);
                        var zeilen = tag.Buchungen.Count;
                        var neueZeile = bearbeitbar && Model.Neu && Model.Tag == tag.Datum;
                        var zeilenKlasse = (tag.Datum == Model.Tag ? "ausgewaehlt " : "") + (tag.IstHeute ? "heute " : "") + (!tag.IstArbeitstag ? "frei" : "");
                        var tagesLink = Url.Page(seite, Model.RouteFuer(Model.MonatsBeginn, tag.Datum));
                        var datumWert = tag.Datum.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

                        var zeilenAnzahl = Math.Max(1, zeilen + (neueZeile ? 1 : 0));

                        for (var i = 0; i < zeilenAnzahl; i++)
                        {
                            var buchung = i < zeilen ? tag.Buchungen[i] : null;
                            var istNeu = neueZeile && i == zeilen;
                            var formId = buchung is not null ? $"b-{buchung.Id}" : $"n-{datumWert}";
                            <tr class="@zeilenKlasse @(i == 0 ? "tag-kopf" : "")">
                                <td>
                                    @if (i == 0)
                                    {
                                        <a href="@tagesLink"><strong>@Zeitformat.DatumMitWochentag(tag.Datum)</strong></a>
                                        @if (tag.Feiertag is not null)
                                        {
                                            <span class="feiertag-name">@T(tag.Feiertag)</span>
                                        }
                                    }
                                </td>

                                @if (buchung is not null && bearbeitbar)
                                {
                                    <td><input type="time" name="eingabe.Beginn" value="@Zeitformat.Uhrzeit(buchung.Beginn)" form="@formId" required /></td>
                                    <td><input type="time" name="eingabe.Ende" value="@Zeitformat.Uhrzeit(buchung.Ende)" form="@formId" /></td>
                                    <td>
                                        <select name="eingabe.Art" form="@formId">
                                            @foreach (var art in arten)
                                            {
                                                <option value="@art" selected="@(buchung.Art == art)">@(art == BuchungsArt.Arbeit ? "…" : art.Text())</option>
                                            }
                                        </select>
                                    </td>
                                }
                                else if (buchung is not null)
                                {
                                    <td>@Zeitformat.Uhrzeit(buchung.Beginn)</td>
                                    <td>@Zeitformat.Uhrzeit(buchung.Ende)</td>
                                    <td>@(buchung.Art == BuchungsArt.Arbeit ? "…" : buchung.Art.Text())</td>
                                }
                                else if (istNeu)
                                {
                                    <td><input type="time" name="eingabe.Beginn" form="@formId" required autofocus /></td>
                                    <td><input type="time" name="eingabe.Ende" form="@formId" /></td>
                                    <td>
                                        <select name="eingabe.Art" form="@formId">
                                            @foreach (var art in arten)
                                            {
                                                <option value="@art">@(art == BuchungsArt.Arbeit ? "…" : art.Text())</option>
                                            }
                                        </select>
                                    </td>
                                }
                                else
                                {
                                    <td>…</td>
                                    <td>…</td>
                                    <td>…</td>
                                }

                                <td>
                                    @if (i == 0)
                                    {
                                        if (tag.Ergebnis.Abwesenheit is { } abw)
                                        {
                                            var abwText = $"{abw.Code} – {T(abw.Name)}" + (abw.Genehmigt ? "" : " " + T("(beantragt)"));
                                            <span class="plakette" style="background:@abw.Farbe">@abwText</span>
                                        }
                                        foreach (var h in tag.Ergebnis.Hinweise)
                                        {
                                            <div class="feld-fehler"><svg class="icon"><use href="#i-warnung" /></svg> @h.Text</div>
                                        }
                                    }
                                </td>
                                <td class="zahl">@(i == 0 ? Zeitformat.Dauer(tag.Ergebnis.SollMinuten) : "")</td>
                                <td class="zahl">@(i == 0 && !tag.IstZukunft ? Zeitformat.Dauer(tag.Ergebnis.ArbeitszeitMinuten) : "")</td>
                                <td class="zahl @(tag.SaldoKontostand < 0 ? "negativ" : "")">@(i == 0 && !tag.IstZukunft ? Zeitformat.Dauer(tag.SaldoKontostand) : "")</td>
                                <td class="aktionen">
                                    @if ((buchung is not null && bearbeitbar) || istNeu)
                                    {
                                        <form id="@formId" method="post" asp-page-handler="Speichern" data-bestaetigen="@F("Zeitkorrektur für {0} übernehmen?", Zeitformat.DatumMitWochentag(tag.Datum))" data-bestaetigen-titel="@T("Zeitkorrektur bestätigen")">
                                            <input type="hidden" name="eingabe.Id" value="@buchung?.Id" />
                                            <input type="hidden" name="eingabe.Datum" value="@datumWert" />
                                            <input type="hidden" name="eingabe.Bemerkung" data-bemerkung-ziel />
                                            <input type="hidden" name="Ma" value="@Model.Ma" />
                                            <button type="submit" class="knopf knopf-klein" title="@T("Speichern")">@T("Speichern")</button>
                                        </form>
                                    }
                                    @if (buchung is not null && bearbeitbar)
                                    {
                                        <form method="post" asp-page-handler="Loeschen" data-bestaetigen="@F("Buchung {0}–{1} am {2} löschen?", Zeitformat.Uhrzeit(buchung.Beginn), Zeitformat.Uhrzeit(buchung.Ende), Zeitformat.Datum(tag.Datum))" data-bestaetigen-titel="@T("Löschung bestätigen")">
                                            <input type="hidden" name="buchungId" value="@buchung.Id" />
                                            <input type="hidden" name="datum" value="@datumWert" />
                                            <input type="hidden" name="Bemerkung" />
                                            <input type="hidden" name="Ma" value="@Model.Ma" />
                                            <button type="submit" class="knopf knopf-gefahr knopf-klein knopf-icon" title="@T("Intervall löschen")" aria-label="@T("Intervall löschen")"><svg class="icon"><use href="#i-loeschen" /></svg></button>
                                        </form>
                                    }
                                    @if (i == 0)
                                    {
                                        <a class="knopf knopf-sekundaer knopf-klein knopf-icon" href="@tagesLink" title="@T("Details, Verlauf und Bemerkungen")" aria-label="@T("Details")"><svg class="icon"><use href="#i-details" /></svg></a>
                                        @if (Model.IstEigeneAnsicht)
                                        {
                                            <a class="knopf knopf-sekundaer knopf-klein knopf-icon" asp-page="/Antraege/Abwesenheit" asp-route-von="@datumWert" asp-route-bis="@datumWert" title="@T("An- oder Abwesenheit hinzufügen")" aria-label="@T("An- oder Abwesenheit hinzufügen")"><svg class="icon"><use href="#i-kalender" /></svg></a>
                                        }
                                        @if (bearbeitbar && !neueZeile)
                                        {
                                            <a class="knopf knopf-erfolg knopf-klein knopf-icon" href="@Url.Page(seite, Model.RouteFuer(Model.MonatsBeginn, tag.Datum, neu: true))" title="@T("Intervall hinzufügen")" aria-label="@T("Intervall hinzufügen")"><svg class="icon"><use href="#i-plus" /></svg></a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <p class="feld-hilfe">@F("Zeiten können maximal {0} Tage rückwirkend erfasst werden. Buchungen in der Zukunft sind nicht möglich. „…“ steht für normale Arbeitszeit.", Model.Optionen.MaxRueckwirkendeTage)</p>
    </section>

    <aside class="karte detailbereich" aria-label="@T("Detailfenster")">
        @if (auswahl is not null)
        {
            var e = auswahl.Ergebnis;
            <h2><svg class="icon"><use href="#i-kalender" /></svg>@Zeitformat.DatumMitWochentag(auswahl.Datum)</h2>

            <div class="detail-abschnitt">
                <h3>@T("Plandetails")</h3>
                <ul class="detail-liste">
                    <li><span>@T("Geplanter Dienst")</span><strong>@(e.SollMinuten > 0 ? F("{0} Gleitzeit", Zeitformat.Dauer(e.SollMinuten)) : auswahl.Feiertag is null ? T("Frei") : T(auswahl.Feiertag))</strong></li>
                    <li><span>@T("Rahmenarbeitszeit")</span><strong>@Model.Optionen.Rahmenarbeitszeit.Beginn – @Model.Optionen.Rahmenarbeitszeit.Ende</strong></li>
                </ul>
            </div>

            <div class="detail-abschnitt">
                <h3>@T("Bewerteter Dienst")</h3>
                @if (auswahl.IstZukunft)
                {
                    <p class="leer">@T("Noch nicht bewertet.")</p>
                }
                else
                {
                    <ul class="detail-liste">
                        <li><span>@T("Anwesenheit")</span><strong>@Zeitformat.Dauer(e.AnwesenheitMinuten)</strong></li>
                        <li><span>@T("Anerkannte Pausen")</span><strong>@Zeitformat.Dauer(e.PausenMinuten)</strong></li>
                        <li><span>@T("Pausenabzug")</span><strong>@Zeitformat.Dauer(e.PausenabzugMinuten)</strong></li>
                        @if (e.GekappteMinuten > 0)
                        {
                            <li><span>@T("Gekappt (> 10 Std.)")</span><strong>@Zeitformat.Dauer(e.GekappteMinuten)</strong></li>
                        }
                        @if (e.VorRahmenMinuten + e.NachRahmenMinuten > 0)
                        {
                            <li><span>@T("Außerhalb Rahmen")</span><strong>@Zeitformat.Dauer(e.VorRahmenMinuten + e.NachRahmenMinuten)</strong></li>
                        }
                        <li><span>@T("Normalarbeitszeit")</span><strong>@Zeitformat.Dauer(e.NettoArbeitMinuten)</strong></li>
                        <li><span>@T("Wegezeit gesamt")</span><strong>@Zeitformat.Dauer(e.WegezeitMinuten)</strong></li>
                        <li><span>@T("davon auf Arbeitszeit")</span><strong>@Zeitformat.Dauer(e.WegezeitAufArbeitszeit)</strong></li>
                        @if (e.KrankGutschrift > 0)
                        {
                            <li><span>@T("Krank untertägig")</span><strong>@Zeitformat.Dauer(e.KrankGutschrift)</strong></li>
                        }
                        @if (e.Abwesenheit is { Genehmigt: true })
                        {
                            <li><span>@F("Gutschrift {0}", T(e.Abwesenheit.Name))</span><strong>@Zeitformat.Dauer(e.AbwesenheitsGutschrift)</strong></li>
                        }
                        <li><span>@T("Ist")</span><strong>@Zeitformat.Dauer(e.ArbeitszeitMinuten)</strong></li>
                        <li><span>@T("Tagessaldo")</span><strong>@Zeitformat.Dauer(e.SaldoDelta)</strong></li>
                        <li><span>@T("Gleitzeitsaldo")</span><strong>@Zeitformat.Dauer(auswahl.SaldoKontostand)</strong></li>
                        <li><span>@T("Wegezeitkonto")</span><strong>@Zeitformat.Dauer(auswahl.WegezeitKontostand)</strong></li>
                        <li><span>@T("Sonderarbeitszeitkonto")</span><strong>@Zeitformat.Dauer(auswahl.SonderarbeitszeitKontostand)</strong></li>
                    </ul>
                    @if (auswahl.IstHeute)
                    {
                        <p class="feld-hilfe">@T("Für den laufenden Tag werden die Zeiten bis zur aktuellen Uhrzeit gewertet.")</p>
                    }
                }
            </div>

            @if (Model.IstEigeneAnsicht && !auswahl.IstZukunft)
            {
                var b = auswahl.Berechtigung;
                <div class="detail-abschnitt">
                    <h3>@T("Berechtigungen")</h3>
                    <form method="post" asp-page-handler="Freigabe" class="formular">
                        <input type="hidden" name="datum" value="@auswahl.Datum.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                        <input type="hidden" name="Ma" value="@Model.Ma" />
                        <label class="checkbox"><input type="checkbox" name="ueber10" value="true" checked="@(b?.ArbeitUeber10Stunden == true)" disabled="@(b?.ArbeitUeber10Stunden == true)" /> @T("Arbeit > 10 Std.")</label>
                        <label class="checkbox"><input type="checkbox" name="nachRahmen" value="true" checked="@(b?.ArbeitNachRahmen == true)" disabled="@(b?.ArbeitNachRahmen == true)" /> @T("Arbeit nach Rahmen")</label>
                        <label class="checkbox"><input type="checkbox" name="vorRahmen" value="true" checked="@(b?.ArbeitVorRahmen == true)" disabled="@(b?.ArbeitVorRahmen == true)" /> @T("Arbeit vor Rahmen")</label>
                        <textarea class="eingabe" name="bemerkung" rows="2" placeholder="@T("Bemerkung (z. B. Sondereinsatz)")"></textarea>
                        <button type="submit" class="knopf knopf-klein">@T("Antrag stellen")</button>
                    </form>
                    <p class="feld-hilfe">@T("Die Zeiten werden durch die Antragstellung direkt gutgeschrieben, bei Ablehnung aber wieder abgezogen. Auch Wegezeit nach Rahmen benötigt diesen Antrag.")</p>
                </div>

                @if (auswahl.IstHeute && (Model.UebertragZeitraumAktiv || Model.UebertragBeantragt))
                {
                    <div class="detail-abschnitt">
                        <h3>@T("Resturlaub Vorjahr")</h3>
                        <form method="post" asp-page-handler="Urlaubsuebertrag" class="formular" data-bestaetigen="@F("Übertragung des Resturlaubs bis {0} beantragen?", Zeitformat.Datum(UrlaubOptions.Datum(Model.Heute.Year, Model.Optionen.Urlaub.VerlaengerterVerfall)))" data-bestaetigen-titel="@T("Antrag stellen")">
                            <input type="hidden" name="datum" value="@auswahl.Datum.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                            <label class="checkbox"><input type="checkbox" name="kappung" value="true" checked="@(!Model.UebertragBeantragt)" disabled="@Model.UebertragBeantragt" /> @T("Kappung Urlaub Vorjahr")</label>
                            @if (!Model.UebertragBeantragt)
                            {
                                <textarea class="eingabe" name="Bemerkung" rows="2" placeholder="@T("Grund für die Aufhebung der Urlaubskappung (optional)")"></textarea>
                                <button type="submit" class="knopf knopf-klein">@T("Antrag stellen")</button>
                            }
                        </form>
                        <p class="feld-hilfe">
                            @(Model.UebertragBeantragt
                                ? T("Die Übertragung wurde bereits beantragt.")
                                : F("Häkchen entfernen und „Antrag stellen“ – der Resturlaub kann dann bis zum {0} genommen werden (zweistufige Genehmigung).", Zeitformat.Datum(UrlaubOptions.Datum(Model.Heute.Year, Model.Optionen.Urlaub.VerlaengerterVerfall))))
                        </p>
                    </div>
                }

                <div class="detail-abschnitt">
                    <h3>@T("Kontobuchungen")</h3>
                    <form method="post" asp-page-handler="Umbuchung" class="formular" data-bestaetigen="@T("Guthaben auf den Gleitzeitsaldo umbuchen? Eine fehlerhafte Umbuchung kann nur die Personalabteilung rückgängig machen.")" data-bestaetigen-titel="@T("Umbuchung bestätigen")">
                        <input type="hidden" name="datum" value="@auswahl.Datum.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                        <label class="feld">
                            <span>@T("Kontobuchungsformular")</span>
                            <select name="quelle">
                                <option value="@Konto.Sonderarbeitszeit">@F("Umbuchung Sonderarbeitszeitkonto auf Saldo (verfügbar {0})", Zeitformat.Dauer(auswahl.SonderarbeitszeitKontostand))</option>
                                <option value="@Konto.Wegezeit">@F("Umbuchung Wegezeit auf Saldo (verfügbar {0})", Zeitformat.Dauer(auswahl.WegezeitKontostand))</option>
                            </select>
                        </label>
                        <label class="feld"><span>@T("Kontobuchungswert (Std:Min)")</span><input class="eingabe" name="stunden" placeholder="0:00" required /></label>
                        <label class="feld">
                            <span>@T("Datum")</span>
                            <input class="eingabe" type="date" name="buchungsdatum" value="@Model.Heute.AddDays(-1).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" max="@Model.Heute.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="feld-hilfe">@T("Am besten den Vortag wählen – sonst ist die Umbuchung erst am Folgetag sichtbar.")</span>
                        </label>
                        <textarea class="eingabe" name="Bemerkung" rows="2" placeholder="@T("Bemerkung (optional)")"></textarea>
                        <button type="submit" class="knopf knopf-klein">@T("Speichern")</button>
                    </form>
                    @if (auswahl.Kontobuchungen.Count > 0)
                    {
                        <ul class="detail-liste" style="margin-top:.75rem">
                            @foreach (var k in auswahl.Kontobuchungen)
                            {
                                <li><span>@T(k.Text) (@k.Konto.Text())@(k.Storniert ? " – " + T("storniert") : "")</span><strong>@Zeitformat.Dauer(k.Minuten)</strong></li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="detail-abschnitt">
                <h3><svg class="icon"><use href="#i-notiz" /></svg> @T("Tagesbezogene Bemerkung")</h3>
                <form method="post" asp-page-handler="Bemerkung" class="formular">
                    <input type="hidden" name="datum" value="@auswahl.Datum.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" />
                    <input type="hidden" name="Ma" value="@Model.Ma" />
                    <textarea class="eingabe" name="text" rows="3" placeholder="@T("z. B. Dienstreise, Schulung …")">@auswahl.Bemerkung</textarea>
                    <button type="submit" class="knopf knopf-klein">@T("Speichern")</button>
                </form>
            </div>

            <div class="detail-abschnitt">
                <h3><svg class="icon"><use href="#i-verlauf" /></svg> @T("Buchungsverlauf")</h3>
                @if (Model.Verlauf.Count == 0)
                {
                    <p class="leer">@T("Keine Änderungen protokolliert.")</p>
                }
                else
                {
                    <div class="tabellen-rahmen">
                        <table class="tabelle verlauf-tabelle">
                            <thead><tr><th>@T("Details")</th><th>@T("Wann / Wer")</th></tr></thead>
                            <tbody>
                                @foreach (var p in Model.Verlauf)
                                {
                                    <tr>
                                        <td>
                                            @p.Details
                                            @if (!string.IsNullOrEmpty(p.Bemerkung))
                                            {
                                                <br /><em>@p.Bemerkung</em>
                                            }
                                        </td>
                                        <td>@Zeitformat.Zeitpunkt(p.Zeitpunkt)<br />@p.AusgefuehrtVonName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="feld-hilfe">@T("P10 = Kommen, P11 = Wechselbuchung, P20 = Gehen")</p>
                }
            </div>
        }
    </aside>
</div>
