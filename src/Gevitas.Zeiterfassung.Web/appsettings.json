{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5016"
      }
    }
  },

  "ConnectionStrings": {
    "Zeiterfassung": "Data Source=App_Data/zeiterfassung.db"
  },

  "DataProtection": {
    "SchluesselPfad": "App_Data/keys"
  },

  "Authentifizierung": {
    "CookieName": "Gevitas.Zeiterfassung.Auth",
    "SitzungsdauerMinuten": 480,
    "MinPasswortLaenge": 8
  },

  "Seed": {
    "Aktiv": true,
    "AdminBenutzername": "admin",
    "AdminPasswort": "Gevitas#Start2026",
    "Demodaten": false
  },

  "Smtp": {
    "Aktiv": false,
    "Host": "",
    "Port": 587,
    "SslAktiv": true,
    "Benutzer": "",
    "Passwort": "",
    "Absender": "zeiterfassung@gevitas.de"
  },

  "Zeiterfassung": {
    "Firmenname": "Gevitas",
    "Anwendungsname": "Gevitas Zeiterfassung",
    "Zeitzone": "Europe/Berlin",

    "Sollarbeitszeit": {
      "StandardMinutenProTag": 480,
      "Arbeitstage": [ "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ]
    },

    "Rahmenarbeitszeit": {
      "Beginn": "06:00",
      "Ende": "20:00"
    },

    "MaxArbeitszeitMinuten": 600,

    "Pausen": {
      "MinPauseMinuten": 15,
      "Schwelle1Minuten": 360,
      "Pause1Minuten": 30,
      "Schwelle2Minuten": 540,
      "Pause2Minuten": 45,
      "MaxBlockOhnePauseMinuten": 360,
      "BlockPauseMinuten": 15
    },

    "MaxRueckwirkendeTage": 9,

    "Saldo": {
      "UntergrenzeMinuten": -2400,
      "ObergrenzeMinuten": 4800,
      "AmpelGelbAbMinuten": 1200,
      "AmpelRotAbMinuten": 2400
    },

    "Urlaub": {
      "StandardJahresurlaub": 30,
      "Verfall": "03-31",
      "VerlaengerterVerfall": "05-31",
      "UebertragAntragVon": "01-01",
      "UebertragAntragBis": "03-01"
    },

    "KrankOhneAttestMaxTage": 3,
    "MinRuhezeitMinuten": 660,

    "Feiertage": [
      "Neujahr",
      "HeiligeDreiKoenige",
      "Karfreitag",
      "Ostermontag",
      "TagDerArbeit",
      "ChristiHimmelfahrt",
      "Pfingstmontag",
      "Fronleichnam",
      "TagDerDeutschenEinheit",
      "Allerheiligen",
      "ErsterWeihnachtstag",
      "ZweiterWeihnachtstag"
    ],

    "Abwesenheitsarten": [
      { "Code": "U",    "Name": "Urlaub",                                         "Farbe": "#7fb3e6", "Wirkung": "SollGutschrift", "ZaehltAlsUrlaub": true },
      { "Code": "GZ",   "Name": "Gleitzeitabbau",                                 "Farbe": "#2e8b57", "Wirkung": "Gleitzeitabbau" },
      { "Code": "AS",   "Name": "Abbau Sonderarbeitszeit",                        "Farbe": "#7b2d5a", "Wirkung": "AbbauSonderarbeitszeit" },
      { "Code": "AW",   "Name": "Abbau Wegezeit",                                 "Farbe": "#1aa3d9", "Wirkung": "AbbauWegezeit" },
      { "Code": "KR",   "Name": "Krank ohne Attest",                              "Farbe": "#f2a0a0", "Wirkung": "SollGutschrift", "MaxKalendertage": 3 },
      { "Code": "KRE",  "Name": "Krank mit eAU",                                  "Farbe": "#e57373", "Wirkung": "SollGutschrift" },
      { "Code": "SU",   "Name": "Sonderurlaub",                                   "Farbe": "#8bc34a", "Wirkung": "SollGutschrift" },
      { "Code": "SUJ",  "Name": "Sonderurlaub Arbeitsjubiläum (25/40/50 Jahre)",  "Farbe": "#c8e6c9", "Wirkung": "SollGutschrift" },
      { "Code": "SUE",  "Name": "Sonderurlaub eigene Eheschließung",              "Farbe": "#b2ebf2", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "SUGH", "Name": "Sonderurlaub goldene Hochzeit der Eltern",       "Farbe": "#b2ebf2", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "SUHK", "Name": "Sonderurlaub Hochzeit der eigenen Kinder",       "Farbe": "#b2ebf2", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "SUG",  "Name": "Sonderurlaub Niederkunft der Ehefrau",           "Farbe": "#90caf9", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "SUT",  "Name": "Sonderurlaub Todesfall (Ehegatte/Kind/Eltern)",  "Farbe": "#ce93d8", "Wirkung": "SollGutschrift" },
      { "Code": "SUTS", "Name": "Sonderurlaub Todesfall (Schwiegereltern/Geschwister/Großeltern)", "Farbe": "#ce93d8", "Wirkung": "SollGutschrift" },
      { "Code": "SUUD", "Name": "Sonderurlaub Umzug aus dienstlichem Grund",      "Farbe": "#f48fb1", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "SUUP", "Name": "Sonderurlaub Umzug aus persönlichem Grund",      "Farbe": "#f48fb1", "Wirkung": "SollGutschrift", "NachweisErforderlich": true },
      { "Code": "TZT",  "Name": "Teilzeit anderer Tag",                           "Farbe": "#ffcc80", "Wirkung": "SollGutschrift" }
    ],

    "Support": {
      "PersonalabteilungEmail": "personalabteilung@gevitas.de",
      "ItSupportHinweis": "Bei technischen Problemen bitte ein Ticket bei der IT erstellen (Kategorie: Software/Zeiterfassung)."
    }
  }
}
